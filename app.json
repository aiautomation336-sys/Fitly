{
  "expo": {
    "name": "fitly-mvp",
    "slug": "fitly-mvp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-asset",
      [
        "expo-camera",
        {
          "cameraPermission": "Fitly использует камеру для фото-скана тела и расчёта размера."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Fitly использует галерею, чтобы выбрать фото для фото-скана тела."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
